---
import type { Article } from '../lib/articles';
import { articleUrl, formatDate, isoDate } from '../lib/articles';
const { articles } = Astro.props as { articles: Article[] };
---
<ul class="news-list rounded-[var(--radius-card)] bg-white shadow-[0_8px_30px_rgba(123,77,255,.08)] ring-1 ring-line">
  {articles.map((a) => (
    <li>
      <a href={articleUrl(a)} class="block px-5 py-4 text-ink no-underline hover:bg-alt md:px-7">
        <time class="block text-xs font-light text-sub" datetime={isoDate(a.data.publishedAt)}>{formatDate(a.data.publishedAt)}</time>
        <span class="mt-0.5 block font-bold leading-snug">{a.data.title}</span>
      </a>
    </li>
  ))}
</ul>
