---
import type { Article } from '../lib/articles';
import { articleUrl, formatDate, isoDate } from '../lib/articles';
import Thumbnail from './Thumbnail.astro';
import TypeBadge from './TypeBadge.astro';
import VerifiedBadge from './VerifiedBadge.astro';
const { article } = Astro.props as { article: Article };
const d = article.data;
---

<article class="card reveal">
  <a href={articleUrl(article)} class="block text-ink no-underline">
    <Thumbnail article={article} />
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <TypeBadge type={d.type} />
      {!d.verified && <VerifiedBadge verified={false} />}
    </div>
    <h3 class="mt-3 text-[17px] font-bold leading-snug">{d.title}</h3>
    <p class="mt-2 text-sm font-light text-sub">
      {d.service.developerName}<span class="mx-2">・</span><time datetime={isoDate(d.publishedAt)}>{formatDate(d.publishedAt)}</time>
    </p>
  </a>
</article>
