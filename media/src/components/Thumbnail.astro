---
import { Image } from 'astro:assets';
import type { Article } from '../lib/articles';
import { slugOf } from '../lib/articles';

interface Props { article: Article; eager?: boolean; idPrefix?: string }
const { article, eager = false, idPrefix = '' } = Astro.props;
const { title, ogImage } = article.data;
const id = `g-${idPrefix}${slugOf(article)}`;

// 画像がない記事用：タイトル入りグラデーションを自動生成（1行13文字で折り返し、最大3行）
const lines: string[] = [];
const chars = [...title];
for (let i = 0; i < chars.length && lines.length < 3; i += 13) lines.push(chars.slice(i, i + 13).join(''));
if (chars.length > 39) lines[2] = lines[2].slice(0, -1) + '…';
const startY = 90 - (lines.length - 1) * 21;
---

<div class="thumb">
  {
    ogImage ? (
      <Image src={ogImage} alt="" width={eager ? 1000 : 640} height={eager ? 562 : 360} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <svg viewBox="0 0 320 180" role="img" aria-label={title} preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="var(--grad-from)" />
            <stop offset="1" stop-color="var(--grad-to)" />
          </linearGradient>
        </defs>
        <rect width="320" height="180" fill={`url(#${id})`} />
        <circle cx="290" cy="20" r="70" fill="none" stroke="#fff" stroke-opacity=".18" />
        <circle cx="290" cy="20" r="44" fill="none" stroke="#fff" stroke-opacity=".18" />
        <path d="M-10 190 L60 130 L130 190Z" fill="#fff" fill-opacity=".1" />
        {lines.map((l, i) => (
          <text x="24" y={startY + i * 42} fill="#fff" font-size="21" font-weight="900" font-family="'Zen Kaku Gothic New', sans-serif">{l}</text>
        ))}
      </svg>
    )
  }
</div>
