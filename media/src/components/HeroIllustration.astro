---
// FV用オリジナルイラスト：個人開発者が、つくったサービスを紹介している場面（フラット・顔なし）
---
<svg viewBox="0 0 544 440" class="il" role="img" aria-label="個人開発者が、つくったサービスのウィンドウを指し示しているイラスト" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="il-grad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--grad-from)" />
      <stop offset="1" stop-color="var(--grad-to)" />
    </linearGradient>
  </defs>

  <!-- 背景の大きな面 -->
  <circle cx="262" cy="224" r="196" class="soft" />
  <circle cx="262" cy="224" r="214" class="ring" />

  <!-- 床の影 -->
  <ellipse cx="270" cy="414" rx="214" ry="12" class="tint" />

  <!-- ブラウザウィンドウ（つくったサービス） -->
  <rect x="54" y="96" width="300" height="214" rx="16" class="tint2" />
  <rect x="42" y="84" width="300" height="214" rx="16" class="paper" />
  <path d="M42 100a16 16 0 0 1 16-16h268a16 16 0 0 1 16 16v18H42z" class="bar" />
  <circle cx="62" cy="101" r="4.5" class="dot" /><circle cx="78" cy="101" r="4.5" class="dot" /><circle cx="94" cy="101" r="4.5" class="dot" />
  <rect x="112" y="94" width="150" height="14" rx="7" class="paper" />

  <rect x="62" y="136" width="122" height="90" rx="10" fill="url(#il-grad)" />
  <circle cx="150" cy="166" r="14" fill="#fff" fill-opacity=".85" />
  <path d="M62 226V206l34-28 30 22 22-14 36 24v16a10 10 0 0 1-10 10H72a10 10 0 0 1-10-10z" fill="#fff" fill-opacity=".28" />

  <rect x="200" y="138" width="116" height="11" rx="5.5" class="ink" />
  <rect x="200" y="158" width="126" height="7" rx="3.5" class="line" />
  <rect x="200" y="172" width="98" height="7" rx="3.5" class="line" />
  <rect x="200" y="198" width="70" height="26" rx="13" fill="url(#il-grad)" />

  <rect x="62" y="244" width="82" height="40" rx="8" class="alt" />
  <rect x="152" y="244" width="82" height="40" rx="8" class="alt" />
  <rect x="242" y="244" width="82" height="40" rx="8" class="alt" />
  <rect x="72" y="254" width="34" height="9" rx="4.5" class="accent" /><rect x="72" y="270" width="50" height="6" rx="3" class="line" />
  <rect x="162" y="254" width="26" height="9" rx="4.5" class="accent" /><rect x="162" y="270" width="46" height="6" rx="3" class="line" />
  <rect x="252" y="254" width="40" height="9" rx="4.5" class="accent" /><rect x="252" y="270" width="52" height="6" rx="3" class="line" />

  <!-- 確認済みバッジ -->
  <circle cx="338" cy="90" r="19" fill="url(#il-grad)" />
  <path d="M329 90l7 7 12-14" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />

  <!-- アプリアイコン -->
  <g transform="rotate(-9 46 52)">
    <rect x="20" y="26" width="52" height="52" rx="14" fill="url(#il-grad)" />
    <path d="M46 40l11 20H35z" fill="none" stroke="#fff" stroke-width="3.2" stroke-linejoin="round" />
  </g>

  <!-- 吹き出し -->
  <g>
    <path d="M378 50h92a14 14 0 0 1 14 14v34a14 14 0 0 1-14 14h-52l-18 18v-18h-22a14 14 0 0 1-14-14V64a14 14 0 0 1 14-14z" class="paper stroke" />
    <rect x="394" y="68" width="62" height="8" rx="4" class="ink" />
    <rect x="394" y="84" width="82" height="6" rx="3" class="line" />
    <rect x="394" y="96" width="52" height="6" rx="3" class="line" />
  </g>

  <!-- 人物（顔なし） -->
  <!-- 脚・靴 -->
  <rect x="404" y="304" width="17" height="100" rx="8" class="navy" />
  <rect x="426" y="304" width="17" height="100" rx="8" class="navy2" />
  <path d="M399 404h25a4 4 0 0 1 4 4v3h-33v-3a4 4 0 0 1 4-4z" class="shoe" />
  <path d="M424 404h25a4 4 0 0 1 4 4v3h-33v-3a4 4 0 0 1 4-4z" class="shoe" />
  <!-- 胴（パーカー） -->
  <rect x="392" y="218" width="64" height="102" rx="24" class="accent" />
  <path d="M410 316h28" class="hem" />
  <rect x="408" y="276" width="32" height="20" rx="6" class="pocket" />
  <!-- 右腕（体側） -->
  <path d="M448 240q16 22 8 52" class="arm" />
  <circle cx="456" cy="296" r="8.5" class="skin" />
  <!-- 首・頭・髪 -->
  <rect x="416" y="204" width="16" height="18" rx="6" class="skin2" />
  <circle cx="424" cy="188" r="25" class="skin" />
  <path d="M399 188a25 25 0 0 1 50 0c-6-12-18-14-26-12-10 2-18 6-24 12z" class="navy" />
  <path d="M399 190c-3 8-1 14 3 18-1-8 0-12 4-18z" class="navy" />
  <!-- 左腕（ウィンドウを指す） -->
  <path d="M398 238L362 214" class="arm" />
  <circle cx="357" cy="210" r="8.5" class="skin" />

  <!-- 観葉植物 -->
  <path d="M488 372c-18-6-24-24-18-42 16 6 22 24 18 42z" class="leaf" />
  <path d="M490 372c4-20 18-32 36-34-2 20-16 32-36 34z" class="leaf2" />
  <path d="M489 372c-2-26 4-44 14-60 8 18 6 40-14 60z" class="leaf" />
  <path d="M474 372h32l-4 36a6 6 0 0 1-6 5h-12a6 6 0 0 1-6-5z" class="accent" />

  <!-- 飾り（細線の図形・点線・矢印） -->
  <g class="deco">
    <path d="M18 318l18-30 18 30z" />
    <path d="M60 360h60M104 348l16 12-16 12" />
    <circle cx="488" cy="196" r="14" />
    <path d="M470 270v14M463 277h14" />
    <path d="M232 36q22-22 44 0t44 0" />
    <path d="M22 196v54" stroke-dasharray="2 8" stroke-width="2.4" />
  </g>
</svg>

<style>
  .il { width: 100%; height: auto; display: block; }
  .soft { fill: var(--c-accent-soft); }
  .ring { fill: none; stroke: var(--c-accent); stroke-opacity: .28; stroke-width: 1.4; stroke-dasharray: 2 9; stroke-linecap: round; }
  .tint { fill: color-mix(in srgb, var(--c-accent) 14%, #fff); }
  .tint2 { fill: color-mix(in srgb, var(--c-accent) 26%, #fff); }
  .paper { fill: #fff; }
  .stroke { stroke: color-mix(in srgb, var(--c-accent) 30%, #fff); stroke-width: 1.5; }
  .bar { fill: color-mix(in srgb, var(--c-accent) 10%, #fff); }
  .dot { fill: color-mix(in srgb, var(--c-accent) 35%, #fff); }
  .alt { fill: var(--c-alt); }
  .ink { fill: var(--c-text); }
  .line { fill: color-mix(in srgb, var(--c-accent) 20%, #fff); }
  .accent { fill: var(--c-accent); }
  .navy { fill: #2d2b45; }
  .navy2 { fill: #3d3a5c; }
  .shoe { fill: #1f1e33; }
  .skin { fill: #f5c9a6; }
  .skin2 { fill: #e7b08a; }
  .pocket { fill: color-mix(in srgb, #000 12%, var(--c-accent)); }
  .hem { stroke: color-mix(in srgb, #fff 40%, var(--c-accent)); stroke-width: 3; stroke-linecap: round; fill: none; }
  .arm { fill: none; stroke: var(--c-accent); stroke-width: 15; stroke-linecap: round; stroke-linejoin: round; }
  .leaf { fill: var(--grad-to); }
  .leaf2 { fill: color-mix(in srgb, var(--grad-to) 55%, #fff); }
  .deco { fill: none; stroke: var(--c-accent); stroke-opacity: .5; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
</style>
