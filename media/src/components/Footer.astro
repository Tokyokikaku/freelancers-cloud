---
import { SITE } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="bg-footer text-white">
  <div class="container-x py-14">
    <p class="text-lg font-bold">{SITE.name}</p>
    <p class="mt-2 max-w-md text-sm text-white/70">{SITE.description}</p>
    <nav class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm" aria-label="フッター">
      {SITE.nav.map((n) => <a href={n.href} class="py-1 text-white/90 no-underline hover:text-white hover:underline">{n.label}</a>)}
      <a href="/contact/#interview" class="py-1 text-white/90 no-underline hover:underline">掲載希望・取材依頼</a>
      <a href="/rss.xml" class="py-1 text-white/90 no-underline hover:underline">RSS</a>
    </nav>
    <p class="mt-6 text-sm text-white/70">
      運営会社：<a href={SITE.company.url} target="_blank" rel="noopener noreferrer" class="text-white/90 hover:text-white">{SITE.company.name}</a>
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-between gap-3 text-xs text-white/60">
      <a href="/contact/#removal" class="text-white/50 no-underline hover:text-white/80 hover:underline">掲載内容の修正・削除の申請</a>
      <p>© {year} {SITE.name}</p>
    </div>
  </div>
</footer>
