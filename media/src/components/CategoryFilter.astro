---
import { CATEGORIES } from '../site.config';
import type { Article } from '../lib/articles';
// 記事のあるカテゴリだけを表示する。current: 'all' | カテゴリのslug
const { articles, current = 'all' } = Astro.props as { articles: Article[]; current?: string };
const counts = new Map<string, number>();
for (const a of articles) counts.set(a.data.category, (counts.get(a.data.category) ?? 0) + 1);
const items = CATEGORIES.filter((c) => counts.has(c.slug));
---
{
  items.length > 0 && (
    <nav class="flex flex-wrap items-center gap-2" aria-label="カテゴリで絞り込み">
      <span class="mr-1 text-sm font-bold text-sub">カテゴリ</span>
      <a href="/articles/" aria-current={current === 'all' ? 'page' : undefined} class:list={['btn btn-sm', current === 'all' && 'btn-primary']}>すべて</a>
      {items.map((c) => (
        <a href={`/category/${c.slug}/`} aria-current={c.slug === current ? 'page' : undefined} class:list={['btn btn-sm', c.slug === current && 'btn-primary']}>
          {c.label}<span class="ml-1 opacity-60">{counts.get(c.slug)}</span>
        </a>
      ))}
    </nav>
  )
}
