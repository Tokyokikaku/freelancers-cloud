---
// 右側のビジュアル：サンプル用の抽象イメージ（人物写真・サービス画像に差し替え可）
---
<div class="relative mx-auto aspect-square w-full max-w-[440px]" aria-hidden="true">
  <div class="grad-bg absolute inset-[6%] rounded-[36%_64%_55%_45%/50%_40%_60%_50%] opacity-95"></div>
  <svg class="absolute inset-0 h-full w-full" viewBox="0 0 440 440" fill="none">
    <circle cx="220" cy="220" r="200" stroke="var(--c-accent)" stroke-opacity=".35" stroke-dasharray="2 9" stroke-width="1.6" />
    <rect x="120" y="150" width="200" height="132" rx="18" fill="#fff" fill-opacity=".95" />
    <rect x="140" y="172" width="90" height="10" rx="5" fill="var(--c-accent)" fill-opacity=".85" />
    <rect x="140" y="194" width="150" height="7" rx="3.5" fill="#222" fill-opacity=".14" />
    <rect x="140" y="210" width="120" height="7" rx="3.5" fill="#222" fill-opacity=".14" />
    <rect x="140" y="236" width="56" height="26" rx="13" fill="url(#hv)" />
    <defs><linearGradient id="hv" x1="0" y1="0" x2="1" y2="0"><stop stop-color="var(--grad-from)" /><stop offset="1" stop-color="var(--grad-to)" /></linearGradient></defs>
    <circle cx="340" cy="120" r="30" fill="#fff" fill-opacity=".9" />
    <path d="M326 120 L336 130 L355 110" stroke="var(--c-accent)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M80 330 L130 290 L170 330Z" fill="#fff" fill-opacity=".35" />
  </svg>
</div>
