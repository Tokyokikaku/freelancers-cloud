---
// 右側のビジュアル：最新記事のカードを重ねたコラージュ（サービス画面や他人の投稿は使わない）
import type { Article } from '../lib/articles';
import { articleUrl } from '../lib/articles';
import Thumbnail from './Thumbnail.astro';
import TypeBadge from './TypeBadge.astro';
const { articles } = Astro.props as { articles: Article[] };
const [a, b, c] = articles;
const slots = [
  { art: b, cls: 'left-0 top-[4%] w-[56%]', r: '-6deg', d: '1s' },
  { art: c, cls: 'right-0 bottom-0 w-[50%]', r: '6deg', d: '2s' },
  { art: a, cls: 'left-[12%] top-[24%] w-[62%] z-10', r: '1.5deg', d: '0s' },
];
---
<div class="relative mx-auto aspect-[5/4.4] w-full max-w-[560px]">
  <!-- 背景の円・グラデーション -->
  <div class="grad-bg absolute right-[2%] top-[6%] h-[78%] w-[78%] rounded-[44%_56%_50%_50%/52%_44%_56%_48%] opacity-95"></div>
  <svg class="pointer-events-none absolute inset-0 h-full w-full" viewBox="0 0 500 440" fill="none" aria-hidden="true">
    <circle cx="250" cy="220" r="214" stroke="var(--c-accent)" stroke-opacity=".35" stroke-width="1.4" stroke-dasharray="2 9" />
    <circle cx="430" cy="60" r="34" stroke="var(--c-accent)" stroke-opacity=".4" stroke-width="1.4" />
    <path d="M30 380 l22 -38 l22 38z" stroke="var(--c-accent)" stroke-opacity=".5" stroke-width="1.4" stroke-linejoin="round" />
  </svg>

  {slots.map((s) => s.art && (
    <a href={articleUrl(s.art)} class={`float hero-card absolute block text-ink no-underline ${s.cls}`} style={`--r:${s.r};--d:${s.d}`}>
      <Thumbnail article={s.art} idPrefix="hero-" />
      <div class="px-1.5 pb-1.5 pt-2.5">
        <TypeBadge type={s.art.data.type} />
        <p class="mt-1.5 line-clamp-2 text-[12px] font-bold leading-snug md:text-[13px]">{s.art.data.title}</p>
        <p class="mt-1 text-[11px] font-light text-sub">{s.art.data.service.developerName}</p>
      </div>
    </a>
  ))}

  <span class="hero-chip float absolute left-[2%] top-[62%] z-20" style="--r:-3deg;--d:.5s">
    <span class="text-accent">✓</span> 数字は出典つき
  </span>
  <span class="hero-chip float absolute right-[4%] top-[2%] z-20" style="--r:3deg;--d:1.5s">
    <span class="text-accent">#</span> 個人開発
  </span>
</div>
