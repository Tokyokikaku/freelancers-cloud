---
interface Props { title: string; text: string; href: string; cta: string }
const { title, text, href, cta } = Astro.props;
---
<div class="grad-bg relative overflow-hidden rounded-[24px] p-8 text-white md:p-14 reveal">
  <svg class="pointer-events-none absolute -right-10 -top-10 h-[320px] w-[320px] opacity-90 md:right-6 md:top-1/2 md:-translate-y-1/2" viewBox="0 0 320 320" fill="none" aria-hidden="true">
    <circle cx="170" cy="150" r="130" stroke="#fff" stroke-opacity=".25" stroke-width="1.5" />
    <circle cx="170" cy="150" r="88" stroke="#fff" stroke-opacity=".3" stroke-width="1.5" stroke-dasharray="3 7" />
    <circle cx="170" cy="150" r="46" fill="#fff" fill-opacity=".16" />
    <path d="M60 250 L130 180 L100 180 M130 180 L130 210" stroke="#fff" stroke-opacity=".6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M230 40 L275 110 L185 110Z" fill="#fff" fill-opacity=".14" />
  </svg>
  <div class="relative max-w-lg">
    <h3 class="text-2xl font-bold md:text-3xl">{title}</h3>
    <p class="mt-3 font-light leading-relaxed text-white/90">{text}</p>
    <a href={href} class="btn mt-7 !border-white !bg-white !text-accent hover:!bg-accent-soft">{cta}</a>
  </div>
</div>
