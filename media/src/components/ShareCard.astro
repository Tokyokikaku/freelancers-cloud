---
// 「このサービスをシェアする」カード（Xのみ）
interface Props { url: string; text: string }
const { url, text } = Astro.props;
const intent = `https://x.com/intent/post?text=${encodeURIComponent(text)}&url=${encodeURIComponent(url)}`;
---
<section class="rounded-[24px] border border-line bg-white p-6 shadow-[0_6px_24px_rgba(34,34,60,.05)] md:p-8" aria-labelledby="share-title">
  <h2 id="share-title" class="text-xl font-bold">このサービスをシェアする</h2>
  <p class="mt-2 text-sm text-sub">気になったサービスを、Xで紹介できます。</p>
  <div class="mt-5">
    <a
      href={intent}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-line bg-white text-ink transition-colors hover:border-ink hover:bg-ink hover:text-white"
      aria-label="Xでシェアする"
      title="Xでシェアする"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    </a>
  </div>
</section>
