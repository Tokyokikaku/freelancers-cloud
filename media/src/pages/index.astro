---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCards from '../components/HeroCards.astro';
import SectionLabel from '../components/SectionLabel.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import FeatureBanner from '../components/FeatureBanner.astro';
import { getArticles, articleUrl, formatDate, isoDate } from '../lib/articles';
import { SITE } from '../site.config';

const all = await getArticles();
const latest = all.slice(0, 6);
const news = all.slice(0, 3);
const heroCards = ['nyangailab', 'movemaster', 'phone-num-guessr'].map((id) => all.find((a) => a.id === id)).filter((a): a is NonNullable<typeof a> => !!a);
// 「**強調**」部分だけ太字にして強弱をつける
const heroLines = SITE.tagline.split('\n').map((line) => line.split('**'));
---

<BaseLayout>
  <section class="hero">
    <div class="pointer-events-none absolute -bottom-32 -left-24 h-72 w-72 rounded-full bg-white/10" aria-hidden="true"></div>
    <div class="container-x relative grid items-center gap-10 pb-10 pt-12 md:grid-cols-[1fr_1.05fr] md:gap-6 md:pb-16 md:pt-20">
      <div>
        <p class="inline-block rounded-full bg-white/20 px-4 py-1 text-sm font-bold tracking-[0.12em]">個人開発メディア</p>
        <h1 class="hero-title mt-5">
          {heroLines.map((parts) => (
            <span class="block">
              {parts.map((p, i) => (i % 2 === 1 ? <strong class="kw">{p}</strong> : p.split(/([「」])/).map((t) => (t === '「' ? <span class="bk-o">{t}</span> : t === '」' ? <span class="bk-c">{t}</span> : t))))}
            </span>
          ))}
        </h1>
        <p class="hero-lead mt-6 max-w-md text-[15px] font-medium leading-loose tracking-wide text-white/95 md:text-base">{SITE.heroLead}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="/articles/" class="btn btn-on-grad">記事を読む</a>
          <a href="/contact/#interview" class="btn btn-ghost-on-grad">無料掲載希望</a>
        </div>
      </div>
      <HeroCards articles={heroCards} />
    </div>

    <div class="container-x relative pb-14 md:pb-24">
      <div class="news-strip grid gap-0 md:grid-cols-[auto_1fr]">
        <div class="flex items-center gap-3 border-b border-line px-6 py-4 md:border-b-0 md:border-r md:px-8">
          <span class="font-label text-lg font-bold tracking-wider grad-text">NEWS</span>
          <span class="text-sm font-bold">新着ニュース</span>
        </div>
        <ul class="grid md:grid-cols-3">
          {news.map((a) => (
            <li class="border-b border-line last:border-b-0 md:border-b-0 md:border-r md:last:border-r-0">
              <a href={articleUrl(a)} class="block h-full px-6 py-4 text-ink no-underline hover:bg-alt md:px-6">
                <time class="block text-xs text-sub" datetime={isoDate(a.data.publishedAt)}>{formatDate(a.data.publishedAt)}</time>
                <span class="mt-0.5 line-clamp-2 block text-sm font-bold leading-snug">{a.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container-x">
      <SectionLabel en="ARTICLES" title="最新記事" lead="個人開発者のサービス紹介とインタビュー。" />
      <div class="section-body">
        <div class="mb-10"><CategoryFilter articles={all} current="all" /></div>
        <ArticleGrid articles={latest} />
        <div class="mt-14 text-center"><a href="/articles/" class="btn">記事一覧をすべて見る</a></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <SectionLabel en="INTERVIEW" title="開発者インタビュー" lead="サービスが生まれた背景を、本人の言葉で。" />
      <div class="section-body">
        <FeatureBanner
          title="つくった人に、聞いてみた。"
          text="なぜつくったのか、どう続けているのか。個人開発者へのインタビューをまとめています。"
          href="/type/interview/"
          cta="インタビューを読む"
        />
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container-x">
      <SectionLabel en="ABOUT" title="このサイトについて" />
      <div class="section-body max-w-2xl">
        <p class="leading-loose">
          {SITE.name}は、個人開発者がつくったサービスを紹介する小さなメディアです。
          編集部がサービスを実際に調べて紹介記事を執筆するほか、開発者へのインタビュー記事も制作しています。
        </p>
        <p class="mt-4 leading-loose">
          個人開発をしている方にとって、無料でサービスをアピールできるチャンスです。掲載をご希望の方は、お気軽にお問い合わせください。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact/#interview" class="btn btn-primary">無料掲載希望</a>
          <a href="/about/" class="btn">運営者情報</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
