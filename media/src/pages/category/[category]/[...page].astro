---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionLabel from '../../../components/SectionLabel.astro';
import CategoryFilter from '../../../components/CategoryFilter.astro';
import ArticleGrid from '../../../components/ArticleGrid.astro';
import Pagination from '../../../components/Pagination.astro';
import { getArticles } from '../../../lib/articles';
import { SITE, CATEGORIES } from '../../../site.config';

export const getStaticPaths = (async ({ paginate }) => {
  const all = await getArticles();
  return CATEGORIES.filter((c) => all.some((a) => a.data.category === c.slug)).flatMap((c) =>
    paginate(all.filter((a) => a.data.category === c.slug), { params: { category: c.slug }, props: { category: c, all }, pageSize: SITE.pageSize }),
  );
}) satisfies GetStaticPaths;

const { page, category, all } = Astro.props;
---

<BaseLayout
  title={`${category.label}のサービス${page.currentPage > 1 ? `（${page.currentPage}ページ目）` : ''}`}
  description={`個人開発の「${category.label}」カテゴリのサービス紹介記事の一覧です。`}
>
  <section class="section">
    <div class="container-x">
      <SectionLabel en="CATEGORY" title={category.label} tag="h1" lead={`${page.total}本`} />
      <div class="section-body">
        <div class="mb-10"><CategoryFilter articles={all} current={category.slug} /></div>
        <ArticleGrid articles={page.data} />
        <Pagination currentPage={page.currentPage} lastPage={page.lastPage} base={`/category/${category.slug}/`} />
      </div>
    </div>
  </section>
</BaseLayout>
