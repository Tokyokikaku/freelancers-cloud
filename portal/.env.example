# ───── サイト ─────
# 本番URL（canonical / sitemap / OGP に使用。末尾スラッシュなし）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# サイト名（任意）
NEXT_PUBLIC_SITE_NAME=成果報酬ナビ
# 運営者名（フッター・運営情報ページに表示）
NEXT_PUBLIC_OPERATOR_NAME=成果報酬ナビ編集部
# 問い合わせ先メールアドレス（運営情報ページに表示）
NEXT_PUBLIC_CONTACT_EMAIL=info@tyokikaku.co.jp

# ───── Supabase（未設定の場合は src/data/seed.json を使うデモモードで動作） ─────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。絶対に NEXT_PUBLIC_ を付けない・クライアントへ渡さない
SUPABASE_SERVICE_ROLE_KEY=

# ───── 計測 ─────
# GA4 測定ID（例: G-XXXXXXXXXX）
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console のHTMLタグ認証用 content 値（任意）
NEXT_PUBLIC_GSC_VERIFICATION=

# ───── リード通知（任意） ─────
# Resend (https://resend.com) を使ってメール通知する場合
RESEND_API_KEY=
# 送信元（Resendで認証済みのドメイン）例: 成果報酬ナビ <noreply@example.com>
MAIL_FROM=
# 運営側の通知先（リード発生のたびに通知）
LEAD_NOTIFY_EMAIL=
